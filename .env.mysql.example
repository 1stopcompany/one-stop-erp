DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=mysql
DB_NAME=one_stop_erp
DB_USER=one_stop_user
DB_PASSWORD=replace-with-the-same-strong-password-used-in-mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_one_stop_erp
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# --- AI assistant (optional) ---
# Needed for reading documents into a draft BOQ and for the AI project review. Documents are sent to Anthropic.
ANTHROPIC_API_KEY=
# AI_ASSISTANT_MODEL=claude-opus-5
# AI_MAX_UPLOAD_MB=32
# Set to 1 to let the API retry a request on a fallback model if a safety classifier declines it
# AI_REFUSAL_FALLBACK=0

# --- Local AI with Ollama (optional; alternative to Claude: nothing leaves the company, no per-use fee) ---
# 1) Install Ollama (https://ollama.com), then pull a model, e.g.:  ollama pull qwen2.5:7b
# 2) Set AI_PROVIDER=ollama. A 7B model needs ~8 GB of free RAM/VRAM; 14B (qwen2.5:14b) is noticeably better and needs ~16 GB.
AI_PROVIDER=anthropic
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# Optional vision model for scanned PDFs / photos / reading BOQ tables from page images (check ollama.com/library for "vision" models)
# OLLAMA_VISION_MODEL=
# auto = text where a page has text, picture where scanned | images = always pictures (best for tables) | text = text only
# OLLAMA_PDF_MODE=auto
# The model's working memory in tokens (bigger = reads more at once, needs more memory)
# OLLAMA_NUM_CTX=16384

# --- File storage on Dropbox (optional) ---
# When set, every upload (insurance/tender documents, drawings, daily/monthly report attachments, project
# phase photos, ...) is saved to the company's own Dropbox instead of this server's local disk. Leave blank
# to keep using local disk (the default -- nothing else needs to change).
#
# Before switching this on for a server that already has uploaded files, run:
#   python manage.py migrate_media_to_dropbox
# first, so files already on local disk are not left unreachable.
#
# To get the three values below:
#   1) Go to https://www.dropbox.com/developers/apps and create an app -- "Scoped access", "Full Dropbox"
#      (or "App folder" for an isolated folder), any name.
#   2) Under the app's Permissions tab, enable files.content.write and files.content.read, then Submit.
#   3) The app's Settings tab shows "App key" and "App secret" -- that's DROPBOX_APP_KEY / DROPBOX_APP_SECRET.
#   4) A refresh token (not a plain access token, which expires in a few hours) is generated once via a
#      one-time browser step. With the app key from step 3, open this URL in a browser (replace <APP_KEY>):
#        https://www.dropbox.com/oauth2/authorize?client_id=<APP_KEY>&token_access_type=offline&response_type=code
#      Approve access, copy the code it shows, then run (replace <APP_KEY>/<APP_SECRET>/<CODE>):
#        curl https://api.dropboxapi.com/oauth2/token -d code=<CODE> -d grant_type=authorization_code -u <APP_KEY>:<APP_SECRET>
#      The JSON response's "refresh_token" field is DROPBOX_OAUTH2_REFRESH_TOKEN.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_OAUTH2_REFRESH_TOKEN=
# DROPBOX_ROOT_PATH=/one-stop-erp
