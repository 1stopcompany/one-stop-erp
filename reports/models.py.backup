class DailyReportAttachment(models.Model):
    """
    Daily Report Attachment Model
    
    Stores photos and documents for daily reports.
    
    Attributes:
        report (ForeignKey): Associated daily report
        file (FileField): Attached file (photo or document)
        file_type (str): Type of file (photo, document)
        caption (str): Caption or description
        uploaded_at (DateTimeField): Upload timestamp
    """
    
    FILE_TYPE_CHOICES = [
        ('photo', _('Photo')),
        ('document', _('Document')),
    ]
    
    report = models.ForeignKey(
        DailyConstructionReport,
        on_delete=models.CASCADE,
        related_name='attachments',
        help_text=_('Daily report this attachment belongs to')
    )
    
    file = models.FileField(
        upload_to='daily_reports/%Y/%m/%d/',
        help_text=_('Photo or document file')
    )
    
    file_type = models.CharField(
        max_length=20,
        choices=FILE_TYPE_CHOICES,
        default='photo',
        help_text=_('Type of file')
    )
    
    caption = models.CharField(
        max_length=255,
        blank=True,
        help_text=_('Caption or description of the file')
    )
    
    uploaded_at = models.DateTimeField(
        auto_now_add=True,
        help_text=_('Timestamp of upload')
    )
    
    class Meta:
        verbose_name = _('Daily Report Attachment')
        verbose_name_plural = _('Daily Report Attachments')
        ordering = ['report', '-uploaded_at']
        indexes = [
            models.Index(fields=['report', 'file_type']),
        ]
    
    def __str__(self):
        """String representation"""
        return f"{self.report.report_number} - {self.get_file_type_display()}"
