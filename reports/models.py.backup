        verbose_name_plural = _('Equipment')
        ordering = ['report', 'equipment_name']
        indexes = [
            models.Index(fields=['report']),
        ]
    
    def __str__(self):
        """String representation"""
        return f"{self.report.report_number} - {self.equipment_name}"


